# Claude Code / 阿里云百炼 API 配置
# 复制此文件为 .env 并填入实际值

# 阿里云百炼 API Key
# 获取地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_api_key_here

# Claude Code 配置
CLAUDE_API_PROVIDER=openai-compatible
CLAUDE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 可选: 其他模型
# CLAUDE_MODEL=qwen-max
# CLAUDE_MODEL=qwen-coder-plus
